# Не добавляй реальные ключи в git или архив для других людей.
# Вариант 1: зарегистрируй приложение DonationAlerts и используй кнопку «Подключить» в /donations.
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=http://localhost:5173/api/donation-alerts/callback

# Вариант 2: вставь готовый OAuth access token (один из вариантов, не оба).
DONATIONALERTS_ACCESS_TOKEN=

DONATIONALERTS_DONATION_URL=https://www.donationalerts.com/r/vivi_frox
VIVI_PLAYER_KEY=
HINA_PLAYER_KEY=

# Netlify хранит комнаты, голоса и секретные ответы между запросами.
# Ничего для Blobs добавлять не нужно: он включается автоматически на Netlify.
GAME_ROOM=VIVI-HINA

# Twitch EventSub: значения добавляются в Netlify → Site configuration → Environment variables.
# Не выкладывай TWITCH_CLIENT_SECRET, TWITCH_EVENTSUB_SECRET или TWITCH_SETUP_KEY в GitHub.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_SETUP_KEY=
# После первого деплоя: https://ТВОЙ-САЙТ.netlify.app/api/twitch/callback
TWITCH_REDIRECT_URI=
